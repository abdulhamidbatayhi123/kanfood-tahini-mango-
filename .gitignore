# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated outputs (regenerated by the pipeline; not part of the release)
results_phase1/
results_mango/
model/
*.png
*.log

# Third-party public datasets fetched at runtime (NOT redistributed here;
# see their Mendeley DOIs in README.md). The open tahini data under
# data/tahini/ IS tracked and shipped.
data/mango/
data/oils/

# Revision experiments: live, append-only job stores and logs are rewritten while jobs run.
# Committed copies are the *.snapshot.jsonl files made by revision/snapshot.sh.
revision/results/*/*store.jsonl
revision/results/*/*.log
